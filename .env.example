# IT Risk Manager Agent — Environment Variables Template
# ====================================================
# Copy this file to .env and fill in your values.
# This file is .gitignore and will NOT be committed.
#
# For production secrets, use OpenClaw SecretRefs instead of .env:
#   openclaw secrets request OLLAMA_API_KEY
# See docs/SECRETS_MANAGEMENT.md for the full guide.

# ── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite database (default: data/processed/regulatory_updates.db)
# DB_PATH=data/processed/regulatory_updates.db

# ── Ollama ──────────────────────────────────────────────────────────────────
# Ollama API host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# Ollama model name (default: mistral)
OLLAMA_MODEL=mistral

# ── Scraping ─────────────────────────────────────────────────────────────────
# Default delay between requests in seconds (default: 1.0)
# Or set per-source:
# EBA_DELAY=1.0
# MAS_DELAY=1.0
DEFAULT_DELAY=1.0

# ── Directories ─────────────────────────────────────────────────────────────
# DATA_DIR=./data
# RAW_DATA_DIR=data/raw
# PROCESSED_DIR=data/processed
# LOGS_DIR=./logs

# ── Ports ───────────────────────────────────────────────────────────────────
# APP_PORT=8501
# OLLAMA_PORT=11434

# ── GitHub (future integrations) ──────────────────────────────────────────────
# Add via SecretRef: openclaw secrets request GITHUB_TOKEN
# GITHUB_REPO=Tinux-67/IT-risk-manager-agent

# ── Proxy (optional) ─────────────────────────────────────────────────────────
# Proxy secrets: add via SecretRef
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
