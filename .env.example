# IT Risk Manager Agent - Environment Variables
# Copy this file to .env and fill in your values
# This file is in .gitignore and will not be committed

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Database ---
# Path to the SQLite database (default: data/processed/regulatory_updates.db)
# DB_PATH=data/processed/regulatory_updates.db

# --- Ollama ---
# Ollama API host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# Ollama model name (default: mistral)
OLLAMA_MODEL=mistral

# --- Scraping ---
# Default delay between requests in seconds (default: 1.0)
DEFAULT_DELAY=1.0
# User agent for HTTP requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# --- Directories ---
# Base directory for data (default: ./data)
# DATA_DIR=./data
# Raw data directory (default: data/raw)
# RAW_DATA_DIR=data/raw
# Processed data directory (default: data/processed)
# PROCESSED_DIR=data/processed
# Logs directory (default: ./logs)
# LOGS_DIR=./logs

# --- GitHub (for future integrations) ---
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_REPO=Tinux-67/IT-risk-manager-agent

# --- Proxy (optional, for scraping behind corporate firewall) ---
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
