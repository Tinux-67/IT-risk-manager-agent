# GitHub API Configuration for create_github_issues.py
# Copy this file to .env and fill in your values

# Required: GitHub Personal Access Token
# Generate at: https://github.com/settings/tokens
# Scopes needed: repo, project
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Required: GitHub Repository (format: owner/repo)
GITHUB_REPO=Tinux-67/IT-risk-manager-agent

# Optional: Project Board Name (if you want to add issues to a project)
# GITHUB_PROJECT="IT Risk Manager Agent - Refactoring & Optimizations"

# Optional: Project Column Name (default: "To do")
# GITHUB_PROJECT_COLUMN="To do"

# Optional: Dry Run Mode (set to "true" to test without making changes)
# DRY_RUN=true
